{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YD-Y65S-Tool",
  "version": "0.1.0",
  "identifier": "com.y65s.tool",
  "build": {
    "beforeDevCommand": "npm --prefix ../webui run dev",
    "beforeBuildCommand": "npm --prefix ../webui run build",
    "frontendDist": "../webui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "YD-Y65S 键盘工具",
        "width": 900,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
